# ── Server ────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────
# Paste your Neon or Supabase connection string here
# Neon example:    postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Supabase example: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/dbname
